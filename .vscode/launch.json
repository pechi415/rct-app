{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1"
            },
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "run",
                "--port",
                "5001",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true
        }
    ]
}
